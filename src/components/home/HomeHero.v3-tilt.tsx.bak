                    { label: 'Fashion',     Icon: Shirt },
                    { label: 'Home',        Icon: HomeIcon },
                    { label: 'Beauty',      Icon: Sparkle },
                    { label: 'More',        Icon: MoreHorizontal },
                  ].map(({ label, Icon }) => (
