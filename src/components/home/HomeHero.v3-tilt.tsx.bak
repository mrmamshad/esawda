                      Shop Now
                    </button>
                  </div>
                  {/* Simple model figure silhouette */}
                  <div className="relative h-14 w-12">
                    {/* Head */}
                    <div className="absolute left-1/2 top-0 h-4 w-4 -translate-x-1/2 rounded-full bg-[#2A3548]" />
                    {/* Body / suit */}
                    <div
