                  </div>
                </div>

                {/* Big Deals banner — with model figure */}
                <div className="relative mx-3 mt-3 flex items-center justify-between overflow-hidden rounded-xl bg-[#FFE7EC] p-3">
                  <div className="relative z-10">
                    <p className="text-[11px] font-bold text-[#0F1524]">Big Deals</p>
                    <p className="text-[9px] text-[#4C5B78]">Up to 50% OFF</p>
                    <button
