                      <span className="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#FFE7EC]" style={{ color: BRAND_RED }}>
                        <Icon size={11} />
                      </span>
                      <span className="text-[7px] font-semibold text-[#0F1524] leading-tight text-center">{label}</span>
                    </div>
                  ))}
                </div>

                {/* Best selling */}
                <div className="mx-3 mt-3 flex items-center justify-between">
                  <p className="text-[10px] font-bold text-[#0F1524]">Best Selling</p>
                  <span className="text-[8px] font-semibold" style={{ color: BRAND_RED }}>View all</span>
                </div>
                <div className="mx-3 mt-2 grid grid-cols-2 gap-2">
                  <div className="rounded-lg bg-[#F6F7FA] p-2">
                    {/* Headphone visual */}
                    <div className="flex h-14 w-full items-center justify-center rounded-md bg-white">
                      <div className="relative h-8 w-10">
                        <div className="absolute inset-x-0 top-0 h-4 rounded-t-full border-[3px] border-b-0 border-[#0F1524]" />
                        <div className="absolute left-0 bottom-0 h-3 w-2.5 rounded-md bg-[#0F1524]" />
                        <div className="absolute right-0 bottom-0 h-3 w-2.5 rounded-md bg-[#0F1524]" />
                      </div>
                    </div>
                    <p className="mt-1 text-[8px] font-bold text-[#0F1524]">Wireless Headphone</p>
                    <p className="text-[8px] font-bold" style={{ color: BRAND_RED }}>৳4,999</p>
                  </div>
                  <div className="rounded-lg bg-[#F6F7FA] p-2">
                    {/* Smart watch visual */}
                    <div className="flex h-14 w-full items-center justify-center rounded-md bg-white">
                      <div className="relative h-9 w-6">
                        <div className="absolute inset-x-1 top-0 h-1 rounded-t-sm bg-[#0F1524]" />
                        <div className="absolute inset-x-1 bottom-0 h-1 rounded-b-sm bg-[#0F1524]" />
                        <div className="absolute inset-0 top-1 bottom-1 rounded-md bg-[#0F1524]">
                          <div className="absolute inset-0.5 rounded-sm" style={{ backgroundColor: BRAND_RED, opacity: 0.7 }} />
                        </div>
                      </div>
                    </div>
                    <p className="mt-1 text-[8px] font-bold text-[#0F1524]">Smart Watch</p>
                    <p className="text-[8px] font-bold" style={{ color: BRAND_RED }}>৳3,499</p>
                  </div>
                </div>
              </div>
            </div>

            {/* Floating trust badges — right edge stack */}
            <div className="pointer-events-none absolute right-[-8px] top-1/2 hidden -translate-y-1/2 flex-col gap-4 lg:flex">
              <FloatingBadge icon={<ShieldCheck size={16} />} label="Secure Payment" />
              <FloatingBadge icon={<Truck size={16} />}       label="Fast Delivery" />
              <FloatingBadge icon={<Award size={16} />}       label="Best Quality" />
            </div>
          </div>
        </div>

        {/* Corner dot decoration bottom-left of section */}
        <div aria-hidden className="pointer-events-none absolute bottom-10 left-10 hidden grid-cols-4 gap-1.5 md:grid">
          {Array.from({ length: 16 }).map((_, i) => (
            <span key={i} className="h-1 w-1 rounded-full bg-[#0F1524] opacity-20" />
          ))}
        </div>
      </div>
    </section>
