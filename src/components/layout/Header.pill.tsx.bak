'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';
import type { Route } from 'next';
import { Plus } from 'lucide-react';
import { Button } from '@/components/ui/Button';
import { Logo } from './Logo';
import { NavPill } from './NavPill';
import { MobileDrawer } from './MobileDrawer';
import { SearchAutocomplete } from '@/components/interactive/SearchAutocomplete';
import { UserMenu } from './UserMenu';
import { cn } from '@/lib/cn';
import type { User } from '@/types/api';

/**
 * Universal top bar — Mobbin-inspired floating glass pill.
 *
 * The header is a fixed, horizontally-centered pill that hovers 20px from
 * the top of the viewport on every page. It uses a translucent background
 * with a heavy backdrop-blur so it reads gracefully over both light content
 * and dark hero photography.
 *
 *   default   → glass pill with near-black ink text (works on light bg)
 *   onDark    → glass pill tuned for dark hero (light ink text, darker glass)
 *   compact   → same pill, tighter internal padding
 *
 * When `user` is provided the right side shows the avatar chip + Post Ad
 * button; otherwise "Get Started" + "Post Ad" pair.
 *
 * Sized slightly larger than Mobbin (880 × 72 vs 620 × 60) so the eSawda
 * wordmark + two nav pills + CTAs breathe comfortably.
 */
export function Header({
  variant = 'default',
  user,
  showSearch = false,
  className,
}: { variant?: 'default' | 'onDark' | 'compact'; user?: User | null; showSearch?: boolean; className?: string }) {
  const onDark = variant === 'onDark';
  const compact = variant === 'compact';

  // Mobbin-style scroll behavior: at page top the header shows a balanced
  // centered pill. After the user scrolls a few pixels, the nav items
  // shift toward the left and the primary CTA ("Post Ad") slides up from
  // below on the right — the exact interaction Mobbin uses for "Join for
  // free". A simple boolean drives Tailwind transitions; no framer needed.
  const [scrolled, setScrolled] = useState(false);
  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  // Pill container tuned per variant. Backdrop-blur + translucent surface
  // creates the frosted-glass look identical to Mobbin's floating nav.
  const pill = cn(
    'relative flex items-center gap-4',
    'rounded-full border shadow-[0_8px_32px_-12px_rgba(0,0,0,0.18)]',
    'backdrop-blur-2xl backdrop-saturate-150',
    'transition-[max-width,padding,height] duration-500 ease-out',
    compact ? 'h-14 px-5' : 'h-[72px] px-6',
    onDark
      ? 'border-white/10 bg-black/35 text-white'
      : 'border-black/5 bg-white/70 text-ink',
    className,
  );

  return (
    <div
      className={cn(
        'pointer-events-none fixed inset-x-0 top-5 z-50 flex justify-center px-4',
      )}
    >
      <header
        className={cn(
          'pointer-events-auto w-full',
          // Mobbin cadence: at top the pill is compact (~640px) — Logo,
          // nav, Get Started only. On scroll the pill *grows* to ~880px
          // to make room for the "Post Ad" CTA that slides up from below.
          scrolled ? 'max-w-[880px]' : 'max-w-[640px]',
          pill,
        )}
      >
        <Logo variant={onDark ? 'onDark' : 'default'} />

        {/*
          Middle region — nav. Always sits between logo and right cluster;
          `mr-auto` pushes right group to the far edge in both states so
          the extra width introduced on scroll opens a gap on the right,
          which is exactly where the CTA fades in.
        */}
        {showSearch ? (
          <div className="hidden md:block md:flex-1 md:max-w-md ml-4">
            <SearchAutocomplete />
          </div>
        ) : (
          <nav className="hidden md:flex items-center gap-1 ml-4 mr-auto">
            <NavPill label="Explore" onDark={onDark} />
            <NavPill label="Today's Deals" onDark={onDark} />
          </nav>
        )}

        {/*
          Right cluster — user chip / Get Started stays visible in both
          states. The "Post Ad" CTA is the Mobbin "Join for free" animation:
          when at top it's tucked below the pill (opacity 0, translated +12px);
          once scrolled it eases up into place and fades in.
        */}
        <div className="flex items-center gap-2 md:gap-3">
          {user ? (
            <UserMenu user={user} onDark={onDark} />
          ) : (
            <Link href={'/auth/login' as Route} className="hidden sm:inline-flex">
              <Button variant={onDark ? 'onDark' : 'outline'} size="sm">Get Started</Button>
            </Link>
          )}

          {/*
            Post Ad CTA — animated reveal. Wrapper uses grid trick to
            collapse to zero width when hidden, so pill genuinely gets
            smaller instead of holding the CTA's space.
          */}
          <div
            className={cn(
              'hidden sm:grid overflow-hidden',
              'transition-[grid-template-columns,opacity,transform] duration-500 ease-out',
              scrolled
                ? '[grid-template-columns:1fr] opacity-100 translate-y-0'
                : '[grid-template-columns:0fr] opacity-0 translate-y-3 pointer-events-none',
            )}
            aria-hidden={!scrolled}
          >
            <div className="min-w-0">
              <Link href={'/shop/ads/new' as Route}>
                <Button variant="filled" size="sm" leftIcon={<Plus size={16} />}>Post Ad</Button>
              </Link>
            </div>
          </div>

          <MobileDrawer onDark={onDark} />
        </div>
      </header>
    </div>
  );
}

/**
 * Spacer that reserves the vertical space the floating pill header occupies,
 * so page content below doesn't slide under it. Height matches the pill
 * (72px) plus the 20px top offset and a little breathing room.
 */
export function HeaderSpacer({ compact = false }: { compact?: boolean }) {
  return <div aria-hidden className={compact ? 'h-[88px]' : 'h-[104px]'} />;
}
