# ── eShauda frontend environment ──────────────────────────────────────
# Copy to `.env.local` and fill with real values. Everything prefixed
# `NEXT_PUBLIC_` is shipped to the browser.

# Backend Laravel API base (versioned, with trailing /api/v1).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100/api/v1

# Absolute URL where this frontend is served — used for OG tags and the
# OAuth `redirect_uri`. In dev this is your Next.js origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for on-demand ISR revalidation (Laravel → Next.js).
# Must match FRONTEND_REVALIDATE_SECRET in the backend .env.
REVALIDATE_SECRET=change-me

# ── Social sign-in (optional) ─────────────────────────────────────────
# The Bikroy-style login popup shows "Google" / "Facebook" buttons only
# when these are set. Wire the corresponding OAuth apps as documented in
# docs/oauth-setup.md.

# Google Cloud → APIs & Services → Credentials → OAuth Client ID (Web).
# Authorized redirect URI must be:  {NEXT_PUBLIC_SITE_URL}/auth/oauth-callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
